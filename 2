@font-face {
  font-family: "PixelFont";
  src: url("fonts/RasterForgeRegular-JpBgm.ttf");
  font-weight: normal;
  font-style: normal;
}
/* Loading overlay covers the whole screen */
#loading-screen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #000000;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  transition: opacity 0.5s ease;
}
/* Hide the loader after fade-out */
#loading-screen.hidden {
  opacity: 0;
  pointer-events: none;
}
#loading-gif {
  width: 200px;
  height: auto;
  margin-bottom: 20px;
}
body {
  margin: 0;
  min-height: 100vh;
  font-family: "PixelFont", sans-serif;
  font-size: 16px;
  background: linear-gradient(to bottom, #e3f3ff, #98c8ff);
}
#loading-text {
  font-family: "PixelFont", sans-serif;
  font-size: 18px;
  margin-bottom: 15px;
  color: #333;
}
/* Progress bar container */
#progress-container {
  width: 300px;
  height: 20px;
  background-color: #e0e0e0;
  border-radius: 10px;
  overflow: hidden;
}
/* The filling bar — animated via CSS over 4s */
#progress-bar {
  width: 0%;
  height: 100%;
  background-color: #4caf50;
  animation: fill 1.5s linear forwards;
}
@keyframes fill {
  from {
    width: 0%;
  }
  to {
    width: 100%;
  }
}
/* Hide main content until loading is done */
#main-content {
  border: 2px solid #333;
  border-radius: 10px;
  padding: 20px;
  padding: 20px;
  margin: 20px;
  background-color: rgba(255, 255, 255, 0.8);
}
